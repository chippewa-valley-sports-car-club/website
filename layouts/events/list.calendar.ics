{{- $lines := slice "BEGIN:VCALENDAR" "VERSION:2.0" "PRODID:-//CVSCC//Events//EN" "X-WR-CALNAME:CVSCC events" -}}
{{- range .Pages -}}
  {{- $start := .Date -}}
  {{- $end := .Date -}}
  {{- with .Params.end_date }}{{ $end = time.AsTime . }}{{ end -}}
  {{- $dtend := $end.AddDate 0 0 1 -}}
  {{- $summary := replace (replace (replace .Title "\\" "\\\\") "," "\\,") ";" "\\;" -}}
  {{- $lines = $lines | append "BEGIN:VEVENT" -}}
  {{- /* UID must not change when the domain does, or calendars duplicate every event. */ -}}
  {{- $lines = $lines | append (printf "UID:%s@cvscc.org" (replace (strings.TrimPrefix "/" .Path) "/" "-")) -}}
  {{- $lines = $lines | append (printf "DTSTAMP:%s" (.Lastmod.UTC.Format "20060102T150405Z")) -}}
  {{- $lines = $lines | append (printf "DTSTART;VALUE=DATE:%s" ($start.Format "20060102")) -}}
  {{- $lines = $lines | append (printf "DTEND;VALUE=DATE:%s" ($dtend.Format "20060102")) -}}
  {{- $lines = $lines | append (printf "SUMMARY:%s" $summary) -}}
  {{- $where := .Params.location }}
  {{- with .Params.venue }}{{ with index hugo.Data.venues . }}{{ $where = $where | default .name }}{{ end }}{{ end }}
  {{- with $where }}
    {{- $location := replace (replace (replace . "\\" "\\\\") "," "\\,") ";" "\\;" -}}
    {{- $lines = $lines | append (printf "LOCATION:%s" $location) -}}
  {{- end -}}
  {{- $lines = $lines | append (printf "URL:%s" .Permalink) -}}
  {{- with .Params.summary }}
    {{- $description := replace (replace (replace . "\\" "\\\\") "," "\\,") ";" "\\;" -}}
    {{- $lines = $lines | append (printf "DESCRIPTION:%s" $description) -}}
  {{- end -}}
  {{- $lines = $lines | append "END:VEVENT" -}}
{{- end -}}
{{- $lines = $lines | append "END:VCALENDAR" -}}
{{- range $lines }}{{ printf "%s\r\n" . }}{{ end -}}
