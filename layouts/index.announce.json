{{- $items := slice }}
{{- $pages := (where site.RegularPages "Section" "in" (slice "news" "events" "results")).ByDate.Reverse }}
{{- range $pages }}
{{- /* id is the page's path inside the site, not its URL: fanout's ledger keys on it, and the URL changes when the domain does (github.io -> www.cvscc.org), which would announce everything again. */}}
{{- /* A results page whose PDF hasn't been imported yet (no tables, no
       summary) waits: the import's own deploy announces it a few minutes later. */}}
{{- $waiting := and (eq .Section "results") (strings.HasSuffix (lower (.Params.results_file | default "")) ".pdf") (not (resources.Get (printf "results/%s.md" .File.ContentBaseName))) }}
{{- $item := dict "id" (printf "cvscc:%s" .Path) "url" .Permalink "title" .Title "date_published" (.Date.Format "2006-01-02T15:04:05Z07:00") "_fanout" (dict "announce" (and (eq (.Params.announce | default false) true) (not $waiting)) "kind" .Section) }}
{{- with .Params.summary }}
{{- $item = merge $item (dict "summary" .) }}
{{- end }}
{{- with .Params.image }}
{{- $item = merge $item (dict "image" (. | absURL)) }}
{{- end }}
{{- with .Params.announce_text }}
{{- $item = merge $item (dict "_fanout" (merge (index $item "_fanout") (dict "text" .))) }}
{{- end }}
{{- $items = $items | append $item }}
{{- end }}
{{- $feed := dict "version" "https://jsonfeed.org/version/1.1" "title" site.Title "home_page_url" .Permalink "feed_url" (absURL "announce.json") "items" $items }}
{{ jsonify $feed }}